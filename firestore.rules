service cloud.firestore {
  match /databases/{database}/documents {
    
    // Existing rule provided by user
    match /activities/{activityId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Rules for The FEB10 Project Scholarship
    // Allowing public read/write for MVP. 
    // In production, you might want to lock this down to only allow:
    // - create: if true (for enrollment)
    // - update: if true (for stage 1 & 2 submissions)
    // - read: if true (for admin dashboard, though ideally this should be creating a custom token or using Admin SDK)
    match /applications/{document=**} {
      allow read, write: if true;
    }
  }
}
